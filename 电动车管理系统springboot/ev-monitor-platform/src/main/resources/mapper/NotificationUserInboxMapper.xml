<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.evmonitorplatform.mapper.NotificationUserInboxMapper">

    <select id="selectByUserAndNotificationIds" resultType="com.example.evmonitorplatform.entity.NotificationUserInbox">
        SELECT * FROM notification_user_inbox
        WHERE user_id = #{userId}
        AND notification_id IN
        <foreach collection="notificationIds" item="nid" open="(" separator="," close=")">
            #{nid}
        </foreach>
    </select>

    <select id="selectHiddenNotificationIds" resultType="java.lang.Integer">
        SELECT notification_id FROM notification_user_inbox
        WHERE user_id = #{userId} AND hidden = 1
        AND notification_id IN
        <foreach collection="notificationIds" item="nid" open="(" separator="," close=")">
            #{nid}
        </foreach>
    </select>
</mapper>
