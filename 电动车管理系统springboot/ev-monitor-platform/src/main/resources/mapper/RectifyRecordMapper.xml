<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.evmonitorplatform.mapper.RectifyRecordMapper">

    <resultMap id="RectifyRecordResultMap" type="com.example.evmonitorplatform.entity.RectifyRecord">
        <id     column="rectify_id"    property="rectifyId"/>
        <result column="illegal_id"    property="illegalId"/>
        <result column="user_id"       property="userId"/>
        <result column="rectify_photo" property="rectifyPhoto"/>
        <result column="rectify_desc"  property="rectifyDesc"/>
        <result column="rectify_time"  property="rectifyTime"/>
        <result column="verify_state"  property="verifyState"/>
        <result column="verify_user_id" property="verifyUserId"/>
        <result column="verify_evidence" property="verifyEvidence"/>
        <result column="verify_remark" property="verifyRemark"/>
        <result column="verify_time"   property="verifyTime"/>
        <result column="create_time"   property="createTime"/>
        <result column="update_time"   property="updateTime"/>
        <!-- 联表字段 -->
        <result column="user_name"       property="userName"/>
        <result column="user_role"       property="userRole"/>
        <result column="verify_user_name" property="verifyUserName"/>
        <result column="license_plate"   property="licensePlate"/>
        <result column="illegal_type"    property="illegalType"/>
    </resultMap>

    <select id="selectRectifyPage" resultMap="RectifyRecordResultMap">
        SELECT
        r.*,
        u.real_name  AS user_name,
        u.user_type  AS user_role
        FROM illegal_rectify_record r
        LEFT JOIN `user` u ON r.user_id = u.user_id
        WHERE 1=1
        <if test="illegalId != null">
            AND r.illegal_id = #{illegalId}
        </if>
        <if test="verifyState != null">
            AND r.verify_state = #{verifyState}
        </if>
        ORDER BY r.rectify_time DESC
    </select>

    <select id="selectRectifyListPage" resultMap="RectifyRecordResultMap">
        SELECT
        r.*,
        u.real_name  AS user_name,
        u.user_type  AS user_role,
        ve.license_plate AS license_plate,
        v.illegal_type AS illegal_type
        FROM illegal_rectify_record r
        LEFT JOIN vehicle_illegal_record v ON r.illegal_id = v.illegal_id AND v.deleted = 0
        LEFT JOIN vehicle_info ve ON v.vehicle_id = ve.vehicle_id
        LEFT JOIN `user` u ON r.user_id = u.user_id
        WHERE 1=1
        <if test="verifyState != null">
            AND r.verify_state = #{verifyState}
        </if>
        <if test="licensePlate != null and licensePlate != ''">
            AND ve.license_plate LIKE CONCAT('%', #{licensePlate}, '%')
        </if>
        ORDER BY r.rectify_time DESC
    </select>

</mapper>